      "static/chunks/app/admin/(dashboard)/layout.js"
    ],
    "/admin/(dashboard)/posts/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/admin/(dashboard)/posts/page.js"
    ],
    "/(public)/layout": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/(public)/layout.js"
    ],
    "/(public)/blog/page": [
      "static/chunks/webpack.js",
