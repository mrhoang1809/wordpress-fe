{
  "mcpServers": {
    "github-fe": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        "ghcr.io/github/github-mcp-server",
        "stdio"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}",
        "GITHUB_REPOSITORY": "mrhoang1809/wordpress-fe"
      },
      "disabled": false,
      "autoApprove": []
    }
  }
}
